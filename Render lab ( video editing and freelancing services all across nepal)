<title>Render Lab | Video Editing, Freelancing & Translation</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
:root{--bg:#f7f7f5;--ink:#111;--muted:#666;--card:#fff;--line:#e7e7e3}
html{scroll-behavior:smooth}
body{font-family:Inter,Arial,sans-serif;background:var(--bg);color:var(--ink);line-height:1.6}
a{text-decoration:none;color:inherit}
.container{width:min(1120px,92%);margin:auto}
nav{height:74px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}
.logo{font-size:22px;font-weight:800;letter-spacing:-1px}
.navlinks{display:flex;gap:28px;font-size:14px;color:#444}
.hero{padding:105px 0 95px}
.eyebrow{text-transform:uppercase;letter-spacing:2px;font-size:12px;color:#777;margin-bottom:18px}
h1{font-size:clamp(48px,8vw,88px);line-height:.98;letter-spacing:-4px;max-width:850px}
.hero p{max-width:650px;color:var(--muted);font-size:19px;margin:28px 0}
.btn{display:inline-block;background:#111;color:#fff;padding:13px 22px;border-radius:7px;font-weight:600;font-size:14px}
.btn.light{background:#fff;color:#111;border:1px solid #ddd;margin-left:8px}
section{padding:80px 0;border-top:1px solid var(--line)}
.section-title{font-size:36px;letter-spacing:-1.5px;margin-bottom:35px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:30px}
.card h3{font-size:20px;margin-bottom:10px}
.card p{color:var(--muted);font-size:15px}
.price{font-size:27px;font-weight:750;margin:18px 0 4px}
.small{font-size:13px;color:#888}
.two{display:grid;grid-template-columns:1fr 1fr;gap:55px;align-items:center}
.bigtext{font-size:28px;line-height:1.3;letter-spacing:-.8px}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:30px}
.stat{border-top:1px solid #ccc;padding-top:15px}.stat strong{font-size:23px;display:block}.stat span{font-size:13px;color:#777}
.contact{background:#111;color:#fff;border-radius:18px;padding:50px}
.contact p{color:#bbb;max-width:600px;margin:12px 0 25px}
.contact .btn{background:#fff;color:#111}
footer{padding:30px 0;color:#777;font-size:13px;display:flex;justify-content:space-between}
@media(max-width:760px){
.navlinks{display:none}.hero{padding:75px 0}.grid,.two{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}
h1{letter-spacing:-2.5px}.btn.light{margin-left:0;margin-top:10px}.contact{padding:32px}
}
</style>
</head>
